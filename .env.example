# Copy to /opt/agent-compose/.env on the server and replace placeholders.
# Never commit the filled .env file.
AGENT_COMPOSE_AUTH_TOKEN=<generate-a-random-token>
OCTOBUS_CAPSET_TOKEN=<octobus-capset-token>

# OpenAI-compatible model endpoint
LLM_API_ENDPOINT=<openai-compatible-endpoint>
LLM_API_PROTOCOL=chat_completions
LLM_MODEL=deepseek-chat
LLM_API_KEY=<model-api-key>

# Optional outbound SMTP settings; the server does not listen for mail.
SRHINO_SMTP_HOST=smtp.qq.com
SRHINO_SMTP_PORT=465
SRHINO_SMTP_USER=<smtp-sender-address>
SRHINO_SMTP_PASSWORD=<smtp-app-password>
SRHINO_SMTP_FROM=<smtp-sender-address>
SRHINO_DUTY_RECIPIENT=1622363185@qq.com
